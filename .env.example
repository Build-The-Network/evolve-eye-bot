# ─── The Eye / NetworkBot — Environment ──────────────────────────────────────
# All Discord IDs, tokens, and tunables read by lib/config.js.
# Missing required vars cause boot to fail loudly — there are no live-ID
# fallbacks in code. Copy this file to .env and fill in real values per
# environment (live / staging / local).
#
# Placeholder values below are intentionally non-numeric so an unedited copy
# fails validation rather than silently booting against the wrong server.

# ─── Credentials (REQUIRED) ──────────────────────────────────────────────────
# Discord bot token — Discord Developer Portal → Bot → Token
TOKEN=your_discord_bot_token_here
# Bearer token for /admin/* HTTP endpoints — generate a random string per env
EYE_ADMIN_TOKEN=your_admin_api_bearer_token_here

# ─── Credentials (OPTIONAL) ──────────────────────────────────────────────────
# Notion integration — only required for setup-notion.js
NOTION_TOKEN=secret_your_notion_token_here

# ── Tracker Issues intake (OPTIONAL — #tracker-bugs → Jarvis fix loop) ──
# Dormant unless NOTION_TOKEN + both of these are set.
TRACKER_BUGS_CHANNEL_ID=
TRACKER_ISSUES_DB_ID=ee9b986218fa41d7a0e882c39e11aa2e
JARVIS_CMDQ_DB_ID=2f5f47525174439eb4698ab5ea2eaac9

# ─── Discord identity (REQUIRED) ─────────────────────────────────────────────
# Application (bot) ID — Developer Portal → General Information → Application ID
CLIENT_ID=your_application_id_here
# Target guild (server) this bot instance manages
GUILD_ID=your_guild_id_here

# ─── Member-facing channels (REQUIRED) ───────────────────────────────────────
WELCOME_CHANNEL_ID=channel_id_here
RULES_CHANNEL_ID=channel_id_here
EVENTS_CHANNEL_ID=channel_id_here
ANNOUNCEMENTS_CHANNEL_ID=channel_id_here
WORLD_CLOCK_CHANNEL_ID=channel_id_here
ACCOUNTABILITY_CHANNEL_ID=channel_id_here
LEADERBOARD_CHANNEL_ID=channel_id_here
VOTE_CHANNEL_ID=channel_id_here
DAILY_WEEKLY_REVIEW_CHANNEL_ID=channel_id_here
TRADE_LOG_CHANNEL_ID=channel_id_here
TRAINING_LOG_CHANNEL_ID=channel_id_here
DIET_LOG_CHANNEL_ID=channel_id_here
# War room voice channel — used by NY AM Session reminders
WAR_ROOM_ID=channel_id_here

# ─── Admin / log channels (REQUIRED) ─────────────────────────────────────────
LOG_COMMANDS_ID=channel_id_here
LOG_MEMBERS_ID=channel_id_here
LOG_INACTIVITY_ID=channel_id_here
LOG_ACCOUNTABILITY_ID=channel_id_here
LOG_ROLES_ID=channel_id_here
LOG_POINTS_AUDIT_ID=channel_id_here
LOG_DELETED_MESSAGES_ID=channel_id_here

# ─── Onboarding roles (REQUIRED) ─────────────────────────────────────────────
PENDING_ROLE_ID=role_id_here
AGREED_ROLE_ID=role_id_here
TIMEZONE_SET_ROLE_ID=role_id_here
ACCOUNTABILITY_SET_ROLE_ID=role_id_here

# ─── Economy / tier roles (REQUIRED) ─────────────────────────────────────────
PROSPECT_ROLE_ID=role_id_here
MEMBER_ROLE_ID=role_id_here
VETERAN_ROLE_ID=role_id_here
ELITE_ROLE_ID=role_id_here
# "Top" is the proven/highest tier role
TOP_ROLE_ID=role_id_here

# ─── Operational (OPTIONAL) ──────────────────────────────────────────────────
# Comma-separated Discord user IDs that never earn points or appear on
# leaderboards (test bots, stale test accounts). Leave unset for [].
IGNORED_USER_IDS=user_id_1,user_id_2

# ─── Chopping Block (OPTIONAL) ───────────────────────────────────────────────
# The discipline-enforcement channel + role. Both must be set together for the
# feature to activate; if either is missing the bot boots normally and the
# Chopping Block module is dormant. Create the channel + role via
# `./eye-admin.sh config apply` (declared in server-config.yaml), capture the
# resulting IDs, then set both vars and restart.
CHOPPING_BLOCK_CHANNEL_ID=channel_id_here
ON_THE_BLOCK_ROLE_ID=role_id_here

# ─── Platform (OPTIONAL) ─────────────────────────────────────────────────────
# Persistent data directory. Defaults to /data (Railway volume mount).
# Override for local development if you don't have /data writable.
DATA_DIR=/data
# HTTP port for the admin API + health probe. Defaults to 3000.
PORT=3000
